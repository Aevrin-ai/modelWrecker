# modelWrecker environment. Copy to .env and fill in only what your config uses:
#   cp .env.example .env
# .env is git-ignored and docker-ignored, so it never enters git or the image. Never commit real keys.
# See docs/reference/ENVIRONMENT.md for the full list and docs/deployment/docker.md for Docker use.

# --- Provider API keys -------------------------------------------------------------------------
# The engine reads a key only from the env var NAMED by `api_key_env:` in your config. Set the ones
# your config names; leave the rest blank. A fully local setup (Ollama) needs none of these.
OPENROUTER_API_KEY=sk-or-replace-me
# OPENAI_API_KEY=sk-replace-me
# ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Engine settings ---------------------------------------------------------------------------
# Default config path for the Python API when no path is passed. The CLI always takes a path
# argument, so `modelwrecker run <file>` ignores this.
# MODELWRECKER_CONFIG=/config/campaign.yaml

# Shared token for the harness MCP server on a networked transport. Not needed for the default stdio
# transport. Use a long random value if you set it.
# MW_MCP_TOKEN=replace-with-a-long-random-token

# --- Docker Compose settings (read by docker compose, not by the engine) -------------------------
# User and group ids the container runs as. On Linux, set these to `id -u` / `id -g` so ./runs is
# writable. Docker Desktop on Windows and macOS works with the defaults.
# MODELWRECKER_UID=10001
# MODELWRECKER_GID=10001
# Extras baked into the image at build time (comma list): mcp, attacks, scan, judges, providers.
# MODELWRECKER_EXTRAS=mcp

# Cloud sync and device credentials are not built yet (Phase 10.8). There are no env vars for them.