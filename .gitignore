# IDE / local prompt scratch
.prompt

# Secrets and config (never commit)
.env
.env.*
config.local.*
*.key

# Red-team run artifacts (can contain harmful content and secrets; keep out of git).
# Root-anchored so they only match top-level output dirs, NOT source packages like
# src/modelwrecker/evidence/ or src/modelwrecker/findings/.
/runs/
/sessions/
/evidence/
/findings/

# Datasets fetched at runtime (respect each dataset's own license)
/library/
/datasets/_cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
